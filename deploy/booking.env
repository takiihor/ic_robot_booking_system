# Single source of truth for how the service runs.
# Read by start.sh, stop.sh and the systemd unit (EnvironmentFile=).
#
# Plain KEY=VALUE only — no shell expansion, no quotes needed. systemd is strict.

# Port. Deliberately uncommon so development tooling never squats on it.
BOOKING_PORT=8757

# Interface to bind.
#   0.0.0.0        all interfaces (LAN + VPN + public)
#   10.8.8.7       VPN only
#   100.114.58.27  Tailscale only
#   127.0.0.1      this machine only
BOOKING_HOST=0.0.0.0

BOOKING_DB_PATH=./data/booking.db
BOOKING_LOG_LEVEL=INFO

# Directory to poll for incoming booking-*.json files (OneDrive-synced folder).
# Set to an empty value to disable the queue processor.
BOOKING_QUEUE_DIR=/mnt/c/Users/lwhor/OneDrive - The Hong Kong Polytechnic University/IC-Booking-Queue
BOOKING_QUEUE_POLL_SECONDS=10

# Facility-to-resource-group mapping (JSON).
# Maps booking email facility names to eligible resource groups.
BOOKING_FACILITY_MAP={"Autonomous Robot Platform": ["Collaborative Robots"]}
